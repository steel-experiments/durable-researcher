{
  "name": "durable-researcher",
  "version": "0.1.0",
  "description": "Self-hosted deep research agent with durable execution via Absurd, browser access via Steel, and LLM agent loop via Pi Agent SDK",
  "type": "module",
  "scripts": {
    "dev": "bun run src/index.ts",
    "api": "bun run src/api/server.ts",
    "test": "vitest run tests",
    "test:watch": "vitest tests",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:init": "bash scripts/db-init.sh"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "*",
    "@mariozechner/pi-ai": "*",
    "@pydantic/monty": "^0.0.17",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.2.15",
    "absurd-sdk": "^0.3.0",
    "dotenv": "^16.4.7",
    "handlebars": "^4.7.9",
    "ink": "^7.0.3",
    "ink-text-input": "^6.0.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.6",
    "steel-sdk": "^0.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
