STEEL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZAI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absurd

# Judge configuration for eval benchmarks.
# Per-benchmark overrides: prefix with RESEARCHRUBRICS_ or DRACO_
# Paper defaults are used when not set.
#
# Gemini rate limits (current account, RPM / TPM / RPD):
#   Gemini 3.1 Pro:  26 RPM, 140.6K TPM, 27 RPD  ← DRACO default
#   Gemini 2.5 Pro:  118 RPM, 637.9K TPM, 1K RPD  ← ResearchRubrics default
#   Gemini 3 Flash:  2 RPM, 3.4K TPM, 9 RPD
#   Gemini 3.1 Flash Lite: unlimited RPM, 4M TPM, 150K RPD
#   Gemini 2.5 Flash Lite: 2 RPM, 18.8K TPM, unlimited RPD
#
# DRACO (~3934 criteria at 20 concurrency): 3.1 Pro = ~151 batches → ~2.5h minimum
# ResearchRubrics (~few hundred criteria): 2.5 Pro = comfortable at 20 concurrency

# ResearchRubrics paper defaults: gemini-2.5-pro-preview-06-05, no thinking, no temp
# RESEARCHRUBRICS_JUDGE_MODEL=gemini-2.5-pro-preview-06-05
# RESEARCHRUBRICS_JUDGE_TEMPERATURE=
# RESEARCHRUBRICS_JUDGE_THINKING=

# DRACO paper defaults: gemini-3.1-pro-preview, thinking=low, temperature=0.2
# (gemini-3-pro-preview is deprecated since March 2026, use 3.1-pro instead)
# DRACO_JUDGE_MODEL=gemini-3.1-pro-preview
# DRACO_JUDGE_TEMPERATURE=0.2
# DRACO_JUDGE_THINKING=low

# Rate limits (requests per minute, 0 = no limit)
# Set these to avoid 429 errors. Check your limits at https://aistudio.google.com/rate-limit
# RESEARCHRUBRICS_JUDGE_RPM=100
# DRACO_JUDGE_RPM=25
# JUDGE_RPM=                  # global fallback

# Global fallbacks (overridden by per-benchmark vars above)
# JUDGE_MODEL=
# JUDGE_TEMPERATURE=
# JUDGE_THINKING=

# Model configuration (format: provider:modelId)
AGENT_MODEL=zai:glm-5.1
UTILITY_MODEL=zai:glm-5.1

# Reasoning effort: minimal, low, medium, high, xhigh (leave empty to disable)
AGENT_REASONING=high
UTILITY_REASONING=

# Maximum task duration in seconds (default: 1200 = 20 minutes)
MAX_DURATION=1200

# Optional campaign cost estimates, in USD per 1M tokens.
# Defaults below match GLM-5.1 pricing: input $1.40, cached input $0.26,
# cached input storage limited-time free, output $4.40.
AGENT_INPUT_PRICE_PER_1M=1.4
AGENT_OUTPUT_PRICE_PER_1M=4.4
AGENT_CACHE_READ_PRICE_PER_1M=0.26
STEEL_SOURCE_PRICE=0
