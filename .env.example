STEEL_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/absurd

# Judge model for eval benchmarks (claude-haiku-4-5-20251001 or gemini-2.5-pro)
JUDGE_MODEL=gemini-2.5-pro-preview-06-05

# Model configuration (format: provider:modelId)
AGENT_MODEL=zai:glm-5.1
UTILITY_MODEL=zai:glm-5.1

# Reasoning effort: minimal, low, medium, high, xhigh (leave empty to disable)
AGENT_REASONING=high
UTILITY_REASONING=

# Maximum task duration in seconds (default: 1200 = 20 minutes)
MAX_DURATION=1200
